olor-token-text-secondary,var(--text-secondary,#5d5d5d))); --oai-wb-text-tertiary: var(--wb-text-tertiary,var(--color-token-text-tertiary,var(--text-tertiary,#8f8f8f))); --oai-wb-surface-primary: var(--wb-surface-primary,var(--color-token-main-surface-primary,var(--main-surface-primary,#fff))); --oai-wb-surface-secondary: var(--wb-surface-secondary,var(--color-token-bg-tertiary,var(--main-surface-secondary,#f5f5f5))); --oai-wb-interactive-secondary-hover: var(--wb-interactive-secondary-hover,var(--color-token-interactive-bg-secondary-hover,var(--oai-wb-surface-secondary))); --oai-wb-border: var(--wb-border,var(--color-token-border,var(--border-light,rgb(0 0 0/8%)))); --oai-wb-border-hover: var(--wb-border-hover,var(--color-token-border-default,var(--border-medium,rgb(0 0 0/12%)))); --oai-wb-divider: var(--wb-divider,var(--color-token-border-light,var(--border-light,rgb(0 0 0/5%)))); --oai-wb-focus: var(--wb-focus,var(--color-token-focus-border,var(--border-strong,#5b9dd9))); --oai-wb-control-border: var(--wb-control-border,var(--interactive-border-focus,var(--oai-wb-focus))); --oai-wb-entity-accent: var(--wb-entity-accent,var(--theme-entity-accent,var(--oai-wb-accent))); --oai-wb-accent: var(--wb-accent,var(--interactive-label-accent-default,#0285ff)); --oai-wb-on-accent: var(--wb-on-accent,var(--bg-primary,#fff)); --oai-wb-interactive-background: var(--wb-interactive-background,var(--interactive-bg-accent-default,color-mix(in srgb,#0285ff 12%,transparent))); --oai-wb-selection: var(--wb-selection,var(--theme-user-selection-bg,var(--selection,#93c5fd))); --oai-wb-radius: var(--wb-radius,1.5rem); --oai-wb-radius-sm: var(--wb-radius-sm,0.5rem); --oai-wb-shadow: var(--wb-shadow,0 4px 80px rgb(0 0 0/2%)); --oai-wb-shadow-lg: var(--wb-shadow-lg,0 10px 30px rgb(0 0 0/12%)); --oai-wb-font-sans: var(--wb-font-sans,var(--font-sans,sans-serif)); --oai-wb-font-mono: var(--wb-font-mono,var(--font-mono,monospace)); --oai-wb-font-size: var(--wb-font-size,0.875rem); --oai-wb-shimmer-dark-contrast: var(--wb-shimmer-dark-contrast,var(--oai-wb-text-tertiary)); --oai-wb-shimmer-dark-secondary: var(--wb-shimmer-dark-secondary,var(--oai-wb-text-tertiary));"><div contenteditable="true" aria-label="Start writing" aria-multiline="true" role="textbox" translate="no" class="ProseMirror content-xaiQhS leading-relaxed"><h1 dir="auto"><span>Support Ticket Priority Prediction and Automated Assignment System Using Agentforce</span></h1><h2 dir="auto"><span>1. Project Overview</span></h2><p dir="auto"><span>This project presents an intelligent support ticket management system built on the Salesforce platform. It automates ticket priority classification, assigns high-priority tasks, and streamlines agent workflows using Salesforce Autolaunched Flows and Agentforce AI Agent configurations.</span></p><h2 dir="auto"><span>2. Business Value &amp; Key Objectives</span></h2><ul data-spread="false"><li><p dir="auto"><strong><span>Faster Ticket Resolution:</span></strong><span> Prioritizes critical issues automatically.</span></p></li><li><p dir="auto"><strong><span>Reduced Manual Effort:</span></strong><span> Replaces manual ticket review with automated logic.</span></p></li><li><p dir="auto"><strong><span>Intelligent Workload Management:</span></strong><span> Assigns high-priority tickets to suitable support agents.</span></p></li></ul><h2 dir="auto"><span>3. Custom Object Data Model</span></h2><p dir="auto"><strong><span>Object Name:</span></strong><span> Support Ticket Intelligence</span></p><p dir="auto"><strong><span>API Name:</span></strong><span> </span><code dir="ltr"><span>Support_Ticket_Intelligence__c</span></code></p><table><tbody><tr><th><span>Field Label</span></th><th><span>API Name</span></th><th><span>Data Type</span></th><th><span>Description</span></th></tr><tr><td><span>Ticket Number</span></td><td><code dir="ltr"><span>Ticket_Number__c</span></code></td><td><span>Auto Number</span></td><td><span>TKT-{0000}</span></td></tr><tr><td><span>Customer</span></td><td><code dir="ltr"><span>Customer__c</span></code></td><td><span>Lookup (Account)</span></td><td><span>Related Account</span></td></tr><tr><td><span>Contact</span></td><td><code dir="ltr"><span>Contact__c</span></code></td><td><span>Lookup (Contact)</span></td><td><span>Customer Contact</span></td></tr><tr><td><span>Issue Type</span></td><td><code dir="ltr"><span>Issue_Type__c</span></code></td><td><span>Picklist</span></td><td><span>Technical, Billing, General</span></td></tr><tr><td><span>Description</span></td><td><code dir="ltr"><span>Description__c</span></code></td><td><span>Long Text Area</span></td><td><span>Issue details</span></td></tr><tr><td><span>Priority Level</span></td><td><code dir="ltr"><span>Priority_Level__c</span></code></td><td><span>Picklist</span></td><td><span>Low, Medium, High</span></td></tr><tr><td><span>Status</span></td><td><code dir="ltr"><span>Status__c</span></code></td><td><span>Picklist</span></td><td><span>New, In Progress, Resolved</span></td></tr><tr><td><span>Created Date</span></td><td><code dir="ltr"><span>Created_Date__c</span></code></td><td><span>Date</span></td><td><span>Ticket Date</span></td></tr><tr><td><span>Assigned To</span></td><td><code dir="ltr"><span>Assigned_To__c</span></code></td><td><span>Lookup (User)</span></td><td><span>Support Agent</span></td></tr><tr><td><span>SLA Breach Risk</span></td><td><code dir="ltr"><span>SLA_Breach_Risk__c</span></code></td><td><span>Checkbox</span></td><td><span>Risk Flag</span></td></tr></tbody></table><h2 dir="auto"><span>4. Flow Architecture &amp; Automation Logic</span></h2><p dir="auto"><strong><span>Flow Type:</span></strong><span> Auto-Launched Flow integrated with Agentforce.</span></p><ol start="1" data-spread="false" style="--rich-text-list-marker-width: 1ch;"><li><p dir="auto"><strong><span>Get Account Records:</span></strong><span> Fetches account details using </span><code dir="ltr"><span>varAccountName</span></code><span>.</span></p></li><li><p dir="auto"><strong><span>Get Support Ticket:</span></strong><span> Retrieves the relevant support ticket associated with the account.</span></p></li><li><p dir="auto"><strong><span>Keyword Analysis:</span></strong><span> Classifies tickets based on description keywords.</span></p><ul data-spread="false"><li><p dir="auto"><strong><span>High Priority:</span></strong><span> "urgent", "not working", or "failure".</span></p></li><li><p dir="auto"><strong><span>Medium Priority:</span></strong><span> "issue", "slow", or "delay".</span></p></li><li><p dir="auto"><strong><span>Low Priority:</span></strong><span> Default fallback category.</span></p></li></ul></li><li><p dir="auto"><strong><span>Action &amp; Task Assignment:</span></strong></p><ul data-spread="false"><li><p dir="auto"><span>Creates a high-priority follow-up task when a high-priority ticket is detected.</span></p></li><li><p dir="auto"><span>Sets output variables such as </span><code dir="ltr"><span>varPriorityLevel</span></code><span>, </span><code dir="ltr"><span>varAssignedTo</span></code><span>, and </span><code dir="ltr"><span>varActionMessage</span></code><span>.</span></p></li></ul></li></ol><h2 dir="auto"><span>5. Agentforce AI Configuration</span></h2><ul data-spread="false"><li><p dir="auto"><strong><span>Topic Label:</span></strong><span> Support Ticket Priority Analysis</span></p></li><li><p dir="auto"><strong><span>API Name:</span></strong><span> </span><code dir="ltr"><span>Support_Ticket_Priority_Analysis</span></code></p></li><li><p dir="auto"><strong><span>Classification:</span></strong><span> Analyzes support ticket details, identifies urgency, and triggers Flow automation.</span></p></li><li><p dir="auto"><strong><span>Agent Action:</span></strong><span> </span><code dir="ltr"><span>Support_Ticket_Intelligence_c</span></code></p></li><li><p dir="auto"><strong><span>Reference Flow:</span></strong><span> </span><code dir="ltr"><span>Support_Ticket_Intellegence</span></code></p></li><li><p dir="auto"><strong><span>Input Parameter:</span></strong><span> </span><code dir="ltr"><span>varAccountName</span></code></p></li><li><p dir="auto"><strong><span>Output Parameters:</span></strong><span> </span><code dir="ltr"><span>varAccountId</span></code><span>, </span><code dir="ltr"><span>varTicketId</span></code><span>, </span><code dir="ltr"><span>varPriorityLevel</span></code><span>, </span><code dir="ltr"><span>varAssignedTo</span></code><span>, </span><code dir="ltr"><span>varActionMessage</span></code></p></li></ul><h2 dir="auto"><span>6. Proof of Functionality &amp; Screenshots</span></h2><h3 dir="auto"><span>6.1 Flow Debug Proof Log</span></h3><p dir="auto"><br class="ProseMirror-trailingBreak"></p><h3 dir="auto"><span>6.2 Support Ticket Intelligence Records Page</span></h3><p dir="auto"><br class="ProseMirror-trailingBreak"></p><h2 dir="auto"><span>7. Project Status</span></h2><ul data-spread="false"><li><p dir="auto"><strong><span>Salesforce Custom Object &amp; Fields:</span></strong><span> Completed and verified.</span></p></li><li><p dir="auto"><strong><span>Auto-Launched Flow Logic:</span></strong><span> Completed, debugged, and tested.</span></p></li><li><p dir="auto"><strong><span>Agentforce Integration:</span></strong><span> Designed and configured as implemented in the project.</span></p></li></ul><h2 dir="auto"><span>8. Conclusion</span></h2><p dir="auto"><span>This project uses Salesforce Flow and Agentforce to improve ticket prioritization, automate support workflows, and help support teams handle critical customer issues efficiently.</span></p></div></div></div></div></div></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] z-[2] [box-shadow:inset_0_0_0_1px_var(--oai-wb-border)] group-hover/writing-block-surface:[box-shadow:inset_0_0_0_1px_var(--oai-wb-border-hover)]"></div></div></div><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">Paste </span><span data-d-text-flow="word" data-d-stream-word="">செய்த </span><span data-d-text-flow="word" data-d-stream-word="">பிறகு </span><span data-d-text-flow="word" data-d-stream-word="">என்ன </span><span data-d-text-flow="word" data-d-stream-word="">ஆகும்?</span></h2><ul class="List-rH8nmc" data-d-component="list" data-d-marker="bullet" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Project </span><span data-d-text-flow="word" data-d-stream-word="">title </span><span data-d-text-flow="word" data-d-stream-word="">பெரிய </span><span data-d-text-flow="word" data-d-stream-word="">heading-ஆக </span><span data-d-text-flow="word" data-d-stream-word="">வரும்.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Project </span><span data-d-text-flow="word" data-d-stream-word="">Overview, </span><span data-d-text-flow="word" data-d-stream-word="">Business </span><span data-d-text-flow="word" data-d-stream-word="">Value </span><span data-d-text-flow="word" data-d-stream-word="">போன்றவை </span><span data-d-text-flow="word" data-d-stream-word="">தனித்தனி </span><span data-d-text-flow="word" data-d-stream-word="">headings-ஆக </span><span data-d-text-flow="word" data-d-stream-word="">வரும்.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Custom </span><span data-d-text-flow="word" data-d-stream-word="">Object </span><span data-d-text-flow="word" data-d-stream-word="">Data </span><span data-d-text-flow="word" data-d-stream-word="">Model </span><span data-d-text-flow="word" data-d-stream-word="">ஒரு </span><span data-d-text-flow="word" data-d-stream-word="">table-ஆக </span><span data-d-text-flow="word" data-d-stream-word="">வரும்.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Flow </span><span data-d-text-flow="word" data-d-stream-word="">Architecture </span><span data-d-text-flow="word" data-d-stream-word="">numbered </span><span data-d-text-flow="word" data-d-stream-word="">steps-ஆக </span><span data-d-text-flow="word" data-d-stream-word="">வரும்.</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">Images </span><span data-d-text-flow="word" data-d-stream-word="">சரியாகத் </span><span data-d-text-flow="word" data-d-stream-word="">தெரிய, </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Flow_Debug_Proof.png</span></code> <span data-d-text-flow="word" data-d-stream-word="">மற்றும் </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Ticket_Records_page.png</span></code> <span data-d-text-flow="word" data-d-stream-word="">files </span><span data-d-text-flow="word" data-d-stream-word="">உங்க </span><span data-d-text-flow="word" data-d-stream-word="">GitHub </span><span data-d-text-flow="word" data-d-stream-word="">repository-ல் </span><span data-d-text-flow="word" data-d-stream-word="">இருக்க </span><span data-d-text-flow="word" data-d-stream-word="">வேண்டும்.</span></p></div></div></li></ul><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">இப்போ </span><span data-d-text-flow="word" data-d-stream-word="">செய்ய </span><span data-d-text-flow="word" data-d-stream-word="">வேண்டியது:</span></span> <span data-d-text-flow="word" data-d-stream-word="">பழைய </span><span data-d-text-flow="word" data-d-stream-word="">content-ஐ </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Ctrl </span><span data-d-text-flow="word" data-d-stream-word="">+ </span><span data-d-text-flow="word" data-d-stream-word="">A</span></code> <span data-d-text-flow="word" data-d-stream-word="">மூலம் </span><span data-d-text-flow="word" data-d-stream-word="">select </span><span data-d-text-flow="word" data-d-stream-word="">செய்து, </span><span data-d-text-flow="word" data-d-stream-word="">மேலே </span><span data-d-text-flow="word" data-d-stream-word="">உள்ளதை </span><span data-d-text-flow="word" data-d-stream-word="">paste </span><span data-d-text-flow="word" data-d-stream-word="">பண்ணுங்க. </span><span data-d-text-flow="word" data-d-stream-word="">பிறகு </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Preview</span></span> <span data-d-text-flow="word" data-d-stream-word="">click </span><span data-d-text-flow="word" data-d-stream-word="">பண்ணிப் </span><span data-d-text-flow="word" data-d-stream-word="">பாருங்க. </span><span data-d-text-flow="word" data-d-stream-word="">சரியாக </span><span data-d-text-flow="word" data-d-stream-word="">இருந்தால் </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Commit </span><span data-d-text-flow="word" data-d-stream-word="">changes</span></span> <span data-d-text-flow="word" data-d-stream-word="">click </span><span data-d-text-flow="word" data-d-stream-word="">பண்ணுங்க.</span></p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">குறிப்பு: </span><span data-d-text-flow="word" data-d-stream-word="">Salesforce-ல் </span><span data-d-text-flow="word" data-d-stream-word="">உண்மையாக </span><span data-d-text-flow="word" data-d-stream-word="">உள்ள </span><span data-d-text-flow="word" data-d-stream-word="">field </span><span data-d-text-flow="word" data-d-stream-word="">names, </span><span data-d-text-flow="word" data-d-stream-word="">Flow </span><span data-d-text-flow="word" data-d-stream-word="">names, </span><span data-d-text-flow="word" data-d-stream-word="">மற்றும் </span><span data-d-text-flow="word" data-d-stream-word="">project </span><span data-d-text-flow="word" data-d-stream-word="">status-க்கு </span><span data-d-text-flow="word" data-d-stream-word="">ஏற்ப </span><span data-d-text-flow="word" data-d-stream-word="">content-ஐ </span><span data-d-text-flow="word" data-d-stream-word="">சரிபார்த்துக் </span><span data-d-text-flow="word" data-d-stream-word="">கொள்ளுங்கள்.</span></p></div></div></div></div></div></div></div></div><span hidden=""></span></div></div><div class="mt-1.5 flex turn-action-controls min-h