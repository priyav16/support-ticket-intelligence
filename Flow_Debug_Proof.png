\",\"secondary_exposures\":[],\"version\":46,\"id_type\":\"userID\",\"value\":{\"sample_ratio\":1,\"enabled\":true,\"ios_enabled\":true,\"android_enabled\":true},\"is_device_based\":false,\"passed\":false},\"726658746\":{\"name\":\"726658746\",\"rule_id\":\"YoyE2dT1G45uKEQHyJFrG\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"730493191\":{\"name\":\"730493191\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1584773534\",\"gateValue\":\"false\",\"ruleID\":\"0EJsCp3GoICPEDkX4u1bn\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"kind\":\"social\",\"name\":\"apple\",\"loginStrategy\":\"existing_user\",\"enabled\":true,\"tempDisabled\":false},\"is_device_based\":false,\"passed\":false},\"734083401\":{\"name\":\"734083401\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"loginStrategy\":\"existing_user\",\"name\":\"email\",\"enabled\":true,\"kind\":\"username\",\"tempDisabled\":false},\"is_device_based\":false,\"passed\":false},\"741821319\":{\"name\":\"741821319\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":26,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"762342243\":{\"name\":\"762342243\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":34,\"id_type\":\"userID\",\"value\":{\"default_rule_indicator\":true},\"is_device_based\":false,\"passed\":false},\"808988452\":{\"name\":\"808988452\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"takeover_url\":\"https://persistent.oaistatic.com/images-app/2026-09-06/individual-image-cards-59c360f8f54deea2.png\",\"takeover_max_seen_count\":0},\"is_device_based\":false,\"passed\":false},\"81