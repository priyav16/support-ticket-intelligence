="./Flow_Debug_Proof_files/305508.9acea2a57d.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/952734.c28a1f0121.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/254963.807cff15fb.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/491001.7324536691.css"><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/507449.744b517c49.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/146419.d944dab66c.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/426505.02b0b4750d.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/388573.c42f55ae06.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/114308.d7313b0c44.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/662526.8eea5c2202.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/415151.56ecb9b8cd.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/380744.99382d5a19.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/216719.95709485da.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/788533.0a5028a019.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/247686.c63ff40915.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/104560.24d502530f.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/834601.d2acbc9c76.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/155100.81568c0eee.css"><link rel="stylesheet" type="text/css" href="./Flow_Debug_Proof_files/794952.9acea2a57d.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
